# ================
# GENERAL SETTINGS
# ================

# OSC communication with TotalMix FX (the machine running the RME driver).
TOTALMIX_HOST=127.0.0.1
TOTALMIX_SEND_PORT=7001
TOTALMIX_LISTEN_PORT=9001
# Listens on all interfaces. Uncritical: leave as is, or pin a specific
# interface IP if you want to restrict where OSC status is received.
TOTALMIX_BIND_ADDRESS=0.0.0.0

# MCP endpoint that this totalmix-mcp-server exposes for AI clients to connect
# to. It is a Streamable HTTP endpoint (see
# https://modelcontextprotocol.io/docs/learn/architecture#participants).
# Leave the bind as is for localhost-only; set it to the LAN interface IP (or
# 0.0.0.0) to let other machines on the LAN reach it.
MCP_HTTP_BIND=127.0.0.1
MCP_HTTP_PORT=8765

# Bearer token required on every MCP request. Use a random string, at least
# 32 characters recommended. If left empty, the endpoint is unauthenticated
# (local development only).
MCP_AUTH_TOKEN=change-me-here!

# TLS (optional). Set both to serve https:// with your own (self-signed) cert.
# Leave empty for plain http:// (localhost testing, or when a separate TLS/
# https reverse proxy terminates TLS in front of this server).
# Note: TLS plus the auth token above is strongly recommended if you ever
# expose this server beyond the LAN.
MCP_TLS_CERT=
MCP_TLS_KEY=

# ===============
# EXPERT SETTINGS
# ===============

# Default settle window (ms) for the get_channel tool: how long to wait for
# TotalMix to push a channel's values back after the resend trigger. A per-call
# settle_ms argument still overrides this.
GET_CHANNEL_SETTLE_MS=250

# Requested OS-level UDP receive buffer (SO_RCVBUF) in bytes for the OSC listen
# socket, applied per-socket via setsockopt. A cold-start /sendall on a device
# with tens of thousands of parameters pushes that many UDP datagrams back in a
# very short burst; if the socket buffer is too small to absorb it, the kernel
# silently drops the overflow (no error anywhere, just a smaller-than-expected
# cache). Unset, the server picks a sensible default: 4 MiB everywhere (macOS/
# BSD reject requests above kern.ipc.maxsockbuf, ~8 MB, so do not go higher
# there), 16 MiB on a detected Raspberry Pi. On Linux the request is silently
# clamped to net.core.rmem_max, so that ceiling must be raised too; the
# actually granted size is logged at startup. 0 forces the plain OS default.
# See README ("Cold-start packet loss") for the analysis and the matching
# sysctl values.
#TOTALMIX_UDP_RECV_BUFFER=4194304

# ==================
# DEVELOPER SETTINGS
# ==================

# Raw debug cache dump at GET /debug/cache, for humans (curl/browser), never
# called by Claude. Off by default: when false the route does not exist at all
# (404). Still bearer-protected when enabled.
MCP_DEBUG_ENABLED=false
